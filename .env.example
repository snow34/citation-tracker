DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citation_tracker
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citation_tracker_test

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=you@example.com

# Resend (https://resend.com) sends password-reset emails. The onboarding sender
# below needs no domain/DNS setup to start; get an API key from your Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Citation Tracker <onboarding@resend.dev>

# Base URL of the deployed frontend — used to build the link inside reset emails.
FRONTEND_URL=http://localhost:8080
